{
  "info": {
    "name": "Halcón API - Evidence 2",
    "description": "REST API of the Halcón order tracking system. Run the folder 'Demo flow' in order: each request saves the ids it creates in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Demo flow (video)",
      "item": [
        {
          "name": "1. Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Creates a Sales employee. Saves the new id in {{user_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Pedro Gómez\",\n    \"email\": \"pedro.gomez@halcon.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"role_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('user_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create order with that user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Creates an order registered by the user from step 1. Status starts as Ordered and invoice_number is generated. Saves {{order_id}} and {{invoice_number}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customer_id\": 1,\n    \"user_id\": {{user_id}},\n    \"delivery_address\": \"Av. Juárez 123, Guadalajara, Jal.\",\n    \"notes\": \"Deliver in the morning\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set('order_id', o.id);",
                  "pm.collectionVariables.set('invoice_number', o.invoice_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}"
              ]
            },
            "description": "Verifies that the order was created."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4a. Update order information",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
